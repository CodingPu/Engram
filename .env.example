# Engram 环境配置模板
# 复制为 .env 并填入实际值

# ============================================
# Claude API (必需)
# ============================================
CLAUDE_API_KEY=sk-ant-...

# ============================================
# QQ Bot 配置（NapCat / Lagrange）
# ============================================

# 推送模式：local (本地 QQ 客户端) / remote (远程服务器)
QQ_MODE=local

# 本地模式下的配置
QQ_LOCAL_HOST=127.0.0.1
QQ_LOCAL_PORT=5700

# Bot 自己的 QQ 号
QQ_BOT_ID=123456789

# 允许的用户 QQ 号（逗号分隔）
QQ_USER_IDS=111111111,222222222

# 允许的群号（逗号分隔，空为不限制）
QQ_GROUP_IDS=

# ============================================
# 存储配置
# ============================================

# MVP: sqlite (default)
# 后期: postgresql
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///engram.db

# Wiki 存储路径
WIKI_PATH=./wiki
RAW_PATH=./raw
ACTIVITIES_PATH=./activities

# ============================================
# 日志配置
# ============================================

LOG_LEVEL=INFO
LOG_FILE=./logs/engram.log

# ============================================
# 推送配置
# ============================================

# 每日推送时段（格式：HH:MM）
PUSH_MORNING_TIME=08:00
PUSH_NOON_TIME=12:30
PUSH_EVENING_TIME=20:00

# 避免打扰的时间段
QUIET_START=22:00
QUIET_END=08:00

# 每天最多推送几个活动
MAX_DAILY_ACTIVITIES=1

# ============================================
# TTS 配置（可选，MVP 可不用）
# ============================================

# 使用的 TTS 服务：edge / mimo
TTS_SERVICE=edge

# 如果用 MiMo
# MIMO_TTS_API_KEY=...

# ============================================
# 开发配置
# ============================================

# 调试模式
DEBUG=False

# 测试数据目录（开发用）
TEST_DATA_DIR=./test_data
